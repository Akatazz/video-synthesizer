<Window x:Class="VideoSynthesizer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="LZX-V · Video Synthesizer" Width="1180" Height="760" MinWidth="800" MinHeight="540"
 Background="#101419" Foreground="#E7EBEF">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20">
   <TextBlock Text="LZX-V" FontSize="30" FontWeight="Bold" Foreground="#9CF5CC"/>
   <TextBlock Text="MODULAR VIDEO SYNTHESIZER" FontSize="12" Margin="0,4,0,16"/>
   <WrapPanel>
    <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click"/>
    <Button Content="Reset feedback" Click="Reset_Click"/>
    <Button Content="Open preset…" Click="Open_Click"/>
    <Button Content="Save preset…" Click="Save_Click"/>
    <Button Content="Save image…" Click="Snapshot_Click"/>
   </WrapPanel>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Border Background="Black" CornerRadius="8" Margin="0,0,24,0">
    <Image x:Name="Preview" Stretch="Uniform" AutomationProperties.Name="Live synthesis preview"/>
   </Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="Controls" Margin="0,0,12,0"/>
   </ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="Status" Text="Starting preview…" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#ACB8C4"/>
 </Grid>
</Window>
